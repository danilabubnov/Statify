# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL for statify-core (Authentication Service)
STATIFY_CORE_POSTGRES_USER=postgres
STATIFY_CORE_POSTGRES_PASSWORD=your_postgres_password
STATIFY_CORE_POSTGRES_LOCAL_URL=jdbc:postgresql://localhost:5432/statify-core
STATIFY_CORE_POSTGRES_DOCKER_URL=jdbc:postgresql://postgres-core:5432/statify-core

# PostgreSQL for statify-data-storage (Data & Synchronizer)
STATIFY_DATA_STORAGE_POSTGRES_USER=postgres
STATIFY_DATA_STORAGE_POSTGRES_PASSWORD=your_postgres_password
STATIFY_DATA_STORAGE_POSTGRES_LOCAL_JDBC_URL=jdbc:postgresql://localhost:5433/statify-data-storage
STATIFY_DATA_STORAGE_POSTGRES_DOCKER_JDBC_URL=jdbc:postgresql://postgres-data-storage:5432/statify-data-storage
STATIFY_DATA_STORAGE_POSTGRES_LOCAL_R2DBC_URL=r2dbc:postgresql://localhost:5433/statify-data-storage
STATIFY_DATA_STORAGE_POSTGRES_DOCKER_R2DBC_URL=r2dbc:postgresql://postgres-data-storage:5432/statify-data-storage

# ==============================================================================
# SERVICE PORTS AND URLS
# ==============================================================================

STATIFY_CORE_PORT=8080
STATIFY_CORE_URL=http://localhost:8080

STATIFY_DATA_API_PORT=8081
STATIFY_DATA_API_URL=http://localhost:8081

STATIFY_SYNCHRONIZER_PORT=8082

# ==============================================================================
# KAFKA CONFIGURATION
# ==============================================================================

SPRING_KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS_LOCAL=localhost:9094
KAFKA_KRAFT_CLUSTER_ID=your_kafka_cluster_id

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================

# Generate strong random keys for production
JWT_ACCESS_SECRET_KEY=your_jwt_access_secret_key_min_32_chars
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRATION_MS=900000 # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days in milliseconds

# ==============================================================================
# HTTP CLIENT CONFIGURATION
# ==============================================================================

HTTP_CLIENT_TIMEOUT_SECONDS=30

# ==============================================================================
# SPOTIFY API CONFIGURATION
# ==============================================================================

# Get credentials at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_API_URL=https://api.spotify.com/
SPOTIFY_AUTH_URL=https://accounts.spotify.com/
SPOTIFY_SCOPE=user-library-read,user-follow-read,user-read-email

# ==============================================================================
# MUSICBRAINZ API CONFIGURATION
# ==============================================================================

MUSIC_BRAINZ_API_URL=https://musicbrainz.org/
MUSIC_BRAINZ_USER_AGENT=Statify/1.0 (https://github.com/yourusername/statify)

# ==============================================================================
# ENCRYPTION CONFIGURATION
# ==============================================================================

# Generate strong random values for production
ENCRYPTION_PASSWORD=your_encryption_password_min_32_chars
ENCRYPTION_SALT=your_encryption_salt_hex_format

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6380
