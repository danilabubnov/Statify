# ==============================================================================
# PostgreSQL Configuration
# ==============================================================================
STATIFY_DATA_STORAGE_POSTGRES_USER=postgres
STATIFY_DATA_STORAGE_POSTGRES_PASSWORD=your_postgres_password
STATIFY_DATA_STORAGE_POSTGRES_LOCAL_JDBC_URL=jdbc:postgresql://localhost:5433/statify-data-storage
STATIFY_DATA_STORAGE_POSTGRES_DOCKER_JDBC_URL=jdbc:postgresql://postgres-data-storage:5432/statify-data-storage

# ==============================================================================
# Server Configuration
# ==============================================================================
STATIFY_DATA_API_PORT=8081
STATIFY_DATA_API_URL=http://localhost:8081

# ==============================================================================
# JWT Configuration
# ==============================================================================
# Must match the JWT_ACCESS_SECRET_KEY from statify-core
JWT_ACCESS_SECRET_KEY=your_jwt_access_secret_key_min_32_chars
