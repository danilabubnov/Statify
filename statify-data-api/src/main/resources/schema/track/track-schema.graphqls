extend type Query {

    topTracksByPopularity(
        page: Int! @Range(min: 0)
        size: Int = 25 @Range(min: 1, max: 52)
        year: Int @Range(min: 1900, max: 2100)
    ): TrackPreviewPage!

}

type TrackPreviewPage {
    items: [TrackPreview!]!
    pageInfo: OffsetPageInfo
    totalCount: Long
}

type TrackPreview {
    id: ID!
    name: String!
    artists: [ArtistSimple!]!
    covers: [Image!]!
}