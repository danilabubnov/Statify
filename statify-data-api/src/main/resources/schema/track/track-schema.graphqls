extend type Query {

    topTracksByPopularity(
        page: Int! @Range(min: 0)
        size: Int = 25 @Range(min: 1, max: 50)
        year: Int @Range(min: 1900, max: 2100)
    ): [TrackPreview!]!

}

type TrackPreview {
    id: ID!
    name: String!
    artists: [ArtistSimple!]!
    covers: [Image!]!
}