extend type Query {

    topTracksByPopularity(
        page: Int! @Range(min: 0)
        size: Int = 25 @Range(min: 1, max: 50)
        from: Date
        to: Date
    ): TrackPreviewPage!

}

type TrackPreviewPage {
    items: [TrackPreview!]!
    pageInfo: OffsetPageInfo
    totalCount: Long
}

type TrackPreview {
    id: ID!
    name: String!
    artists: [ArtistSimple!]!
    covers: [Image!]!
}