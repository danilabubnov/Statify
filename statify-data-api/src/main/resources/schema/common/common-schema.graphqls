type Image {
    imageUrl: String!
    imageHeight: Int!
    imageWidth: Int!
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}

type OffsetPageInfo {
    page: Int!
    size: Int!
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
}