extend type Query {

    topArtistsByPopularity(
        page: Int! @Range(min: 0)
        size: Int = 50 @Range(min: 1, max: 100)
    ): [ArtistPreview!]!

}

type ArtistPreview {
    id: ID!
    name: String!
    images: [Image!]!
}

type ArtistSimple {
    id: ID!
    name: String!
    popularity: Int
    followersTotal: Int
}