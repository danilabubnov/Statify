extend type Query {

    topAlbumsByPopularity(
        page: Int! @Range(min: 0)
        size: Int = 25 @Range(min: 1, max: 52)
        year: Int @Range(min: 1900, max: 2100)
        albumType: AlbumType = ALBUM
    ): AlbumPreviewPage!

}

type AlbumPreviewPage {
    items: [AlbumPreview!]!
    pageInfo: OffsetPageInfo
    totalCount: Long
}

enum AlbumType {
    ALBUM
    SINGLE
    COMPILATION
}

type AlbumPreview {
    id: ID!
    name: String!
    artists: [ArtistSimple!]!
    covers: [Image!]!
}