extend type Query {

    getFavoriteTracks(
        userId: ID!, @NotBlank
        size: Int = 10, @Range(min: 1, max: 20)
        after: ID
    ): FavTrackConnection!

    getFavoriteAlbums(
        userId: ID!, @NotBlank
        size: Int = 10, @Range(min: 1, max: 20)
        after: ID
    ): FavAlbumConnection!

}

type FavTrack {
    id: ID!
    durationMs: Int!
    explicit: Boolean!
    name: String!
    popularity: Int
    trackNumber: Int!
    albumId: ID!
    addedAt: String!
}

type FavAlbum {
    id: ID!
    albumType: String!
    totalTracks: Int!
    name: String!
    label: String
    popularity: Int
    releaseDate: String!
    addedAt: String!
}

type FavTrackConnection {
    edges: [FavTrackEdge!]!
    pageInfo: PageInfo!
}

type FavTrackEdge {
    node: FavTrack!
    cursor: ID!
}

type FavAlbumConnection {
    edges: [FavAlbumEdge!]!
    pageInfo: PageInfo!
}

type FavAlbumEdge {
    node: FavAlbum!
    cursor: ID!
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}