# ==============================================================================
# PostgreSQL Configuration
# ==============================================================================
STATIFY_CORE_POSTGRES_USER=postgres
STATIFY_CORE_POSTGRES_PASSWORD=your_postgres_password
STATIFY_CORE_POSTGRES_LOCAL_URL=jdbc:postgresql://localhost:5432/statify-core
STATIFY_CORE_POSTGRES_DOCKER_URL=jdbc:postgresql://postgres-core:5432/statify-core

# ==============================================================================
# Kafka Configuration
# ==============================================================================
SPRING_KAFKA_BOOTSTRAP_SERVERS_LOCAL=localhost:9094
SPRING_KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092

# ==============================================================================
# JWT Configuration
# ==============================================================================
# Generate strong random keys (minimum 32 characters) for production
JWT_ACCESS_SECRET_KEY=your_jwt_access_secret_key_min_32_chars
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRATION_MS=900000 # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days in milliseconds

# ==============================================================================
# Spotify OAuth2 Configuration
# ==============================================================================
# Get your credentials at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_SCOPE=user-library-read,user-follow-read,user-read-email

# ==============================================================================
# Server Configuration
# ==============================================================================
STATIFY_CORE_PORT=8080
STATIFY_CORE_URL=http://localhost:8080

# ==============================================================================
# Encryption Configuration
# ==============================================================================
# Generate strong random values for production
ENCRYPTION_PASSWORD=your_encryption_password_min_32_chars
ENCRYPTION_SALT=your_encryption_salt_hex_format
