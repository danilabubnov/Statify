# PostgreSQL Configuration
STATIFY_CORE_POSTGRES_USER=postgres
STATIFY_CORE_POSTGRES_PASSWORD=Default123!
STATIFY_CORE_POSTGRES_DOCKER_URL=jdbc:postgresql://postgres-core:5432/statify-core

# Kafka Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_MS=3600000  # 1 hour in milliseconds

# Spotify OAuth2 Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_SCOPE=user-read-private,user-read-email

# Application Configuration
STATIFY_CORE_PORT=8080
STATIFY_CORE_URL=http://localhost:8080

# Encryption
ENCRYPTION_PASSWORD=your_encryption_password
ENCRYPTION_SALT=your_encryption_salt